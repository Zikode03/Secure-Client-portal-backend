{
  "Jwt": {
    "Issuer": "SecureClientPortal",
    "Audience": "SecureClientPortal.Client",
    "SigningKey": "",
    "ExpiresMinutes": 120
  },
  "Storage": {
    "Provider": "local",
    "RootPath": "App_Data/uploads",
    "KeyRingPath": "App_Data/keyring"
  },
  "PortalLinks": {
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "AccessEmail": {
    "Enabled": false,
    "DeliveryMode": "log",
    "FromEmail": "no-reply@example.invalid",
    "FromName": "Secure Client Portal",
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseSsl": true,
    "SmtpUsername": "",
    "SmtpPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
